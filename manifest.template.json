{
  "display_information": {
    "name": "{{APP_NAME}}",
    "description": "{{APP_NAME}} — a simulated {{SIMULATES}} for Slack demos.",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "{{DISPLAY_NAME}}",
      "always_online": true
    },
    "assistant_view": {
      "assistant_description": "Ask {{DISPLAY_NAME}} for help.",
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "assistant:write",
        "chat:write",
        "chat:write.customize",
        "im:history",
        "channels:history",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "assistant_thread_started",
        "assistant_thread_context_changed"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
